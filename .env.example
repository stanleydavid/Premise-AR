# Semak Premis — copy to .env.local and fill in. Never commit real values.
APP_ENV=development                # development | staging | production
APP_URL=http://localhost:3000      # public URL behind the WAF in staging/production
APP_VERSION=                       # set by the build (commit)

# PostgreSQL 16 + PostGIS. The app connects as the non-superuser role semak_app (see README).
DATABASE_URL=postgres://semak_app:CHANGE_ME@localhost:5432/semak
DATABASE_MIGRATION_URL=postgres://semak_owner:CHANGE_ME@localhost:5432/semak   # migrations only
DATABASE_POOL_MAX=10

# Secrets: 32+ random characters each (openssl rand -hex 32)
SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=          # optional; seals the DBKK ID id_token cookie (defaults to SESSION_SECRET)
NRIC_HMAC_SECRET=                 # officers matched by MyDigital-verified IC (only the HMAC is stored)

# DBKK ID (EarthID Enterprise) OIDC client — values from the DBKK/Earth platform team
EARTHID_ISSUER=                   # https://<dbkk-id-host>/api/earthid
EARTHID_CLIENT_ID=
EARTHID_CLIENT_SECRET=
EARTHID_REDIRECT_URI=             # <APP_URL>/api/auth/callback (registered exactly)
EARTHID_POST_LOGOUT_REDIRECT_URI= # <APP_URL>/login (registered)
EARTHID_SCOPES=openid profile email nric mydigital.verification
EARTHID_LINK_BY_EMAIL=false       # true only if DBKK policy allows linking officers by verified e-mail
# EARTHID_NRIC_CLAIM=nric         # override only if the live DBKK ID uses other claim names
# EARTHID_VERIFIED_CLAIM=mydigital_verified

# Evidence photos (mounted volume on the application VM, included in backups)
PHOTO_STORAGE_DIR=/var/lib/semak-premis/photos

# Development / field trials only. Ignored when APP_ENV=production.
DEV_LOGIN_ENABLED=false
TRAINING_LAT=5.6947939
TRAINING_LNG=115.958221

SENTRY_DSN=
LOG_LEVEL=info
